# Cloudflare Worker Local Development Variables (.dev.vars)
# Populated by Wrangler when running `wrangler dev`.
#
# MANDATORY: GUEST_SESSION_SECRET must be configured in every environment.
# Do NOT commit `.dev.vars` containing production credentials.

GUEST_SESSION_SECRET="voxanex_guest_session_secret_local_dev_min_32_chars_random_entropy"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
ENVIRONMENT="development"

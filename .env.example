# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Phase 2 Backend & Database)
# -----------------------------------------------------------------------------
# Public API URL for your Supabase project (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Public anon key safe for browser client initialization
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder"

# Privileged service role key (SERVER-SIDE ONLY - NEVER expose in frontend/Vite)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder"

# Cryptographic salt for signing server-issued guest session tokens
GUEST_SESSION_SECRET="voxanex_guest_session_secret_min_32_chars_random_entropy"

# -----------------------------------------------------------------------------
# WEBRTC STUN / TURN CONFIGURATION (Phase 5 Media Relay)
# -----------------------------------------------------------------------------
# STUN servers default to Google STUN (stun.l.google.com:19302).
# Optional TURN server for symmetric NAT / corporate firewall traversal (e.g. Twilio, Coturn, Metered)
# Server-side only: The backend provides ICE configurations to clients without exposing master provider secrets.
TURN_SERVER_URL="turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp"
TURN_USERNAME="voxanex_relay_user"
TURN_CREDENTIAL="voxanex_relay_credential_token"
